<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/resources/website-logo.ico" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css" integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="/message-page.css">
    <title>Secrect Card | Message</title>
</head>
<body>
    <div class="main-container">

        <div class="card-container">

            <div class="message-header-container">
                <div class="senderName"><%= Message.senderName %></div>
                <div class="senderUserId">@<%= Message.senderUserId %></div>
                <div class="msgTime">Time: <%= Message.msgTime %></div>
            </div>

            <div class="main-message-container">
                <%= Message.message %>
            </div>

            <div class="delete-msg-btn-container">
                <button class="delete-msg-btn"><a href="/inbox/<%= Message.receiverUserId %>/<%= Message._id.toString() %>/delete">Tear Card</a></button>
            </div>

        </div>

        <div class="reply-container">
            <form class="reply-form" action="/inbox/<%= Message.receiverUserId %>/<%= Message._id.toString() %>/deleteAndSendMsg" method="POST">
                <input type="hidden" value="<%= Message.senderUserId %>" name="receiverUserId">
                <textarea class="reply" placeholder=" Reply Your Feelings..." name="message" required></textarea>
                <div class="delete-msg-btn-container"><button class="delete-msg-btn" style="border-radius: 50%;"><i class="fa-solid fa-paper-plane"></i></button></div>
            </form>
        </div>

    </div>
</body>
</html>