<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="./resources/website-logo.ico" type="image/x-icon">
    <link rel="stylesheet" href="./getuserid.css">
    <title>Secrect Card | Get User Id</title>
</head>
<body>
    <div class="main-container">

        <div class="header-container">Secrect Card</div>

        <div class="getuserid-form">

            <div class="font-size-big">Let's Have Your Unique User ID</div>

            <div class="font-size-small">
                A unique user id helps you and others to send or recieve messages without sharing your phone number or email
            </div>

            <form action="/signup" method="POST">

                <div class="inputbox-container">
                    <input type="text" name="userId" class="inputbox" placeholder=" ex. palashhazraofficial" required>
                </div>

                <div class="search-availability-btn-container">
                    <button class="search-availability-btn"> Search Availability </button>
                </div>

            </form>

            <% if (tempMsg) { %>
                <div class="status-container"> <%= tempMsg %> </div>
            <% } %>

            <div class="font-size-small">
                <a href="/">Back To Home</a>
            </div>

        </div>

    </div>
</body>
</html>